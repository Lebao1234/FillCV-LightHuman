# Chép file này thành .env rồi điền giá trị thật
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=8000

# Dung lượng tối đa file tải lên (MB) — phải khớp server.maxUploadSize trong .streamlit/config.toml
MAX_UPLOAD_MB=20
# Số ngày giữ PDF đã xuất trong data/output (0 = tắt tự xoá)
OUTPUT_RETENTION_DAYS=30
# Chỉ đặt =1 khi chạy Docker/root mà Chromium không khởi động được. Bỏ trống trên Windows.
CHROMIUM_NO_SANDBOX=

# Giới hạn thời gian gọi OpenAI (giây) — xem extract.py
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=1
OPENAI_TOTAL_DEADLINE=180
# 1 = để OpenAI lưu phản hồi (mặc định của API, cho phép sửa JSON không cần gửi lại file); 0 = không lưu
OPENAI_STORE=1
# Thư mục file log (mặc định data/logs)
LOG_DIR=

# Đường dẫn (bỏ trống = mặc định; đường dẫn tương đối tính từ thư mục dự án)
OUTPUT_DIR=
LOGO_PATH=
LOGO_HEADER_PATH=
COMPANY_CONFIG=
# Số giây tối đa cho một lần Chromium dựng PDF (mặc định 120)
RENDER_TIMEOUT=
# Số lượt dựng PDF chạy cùng lúc trên toàn app (mỗi lượt ~300-400 MB RAM); người tới sau xếp hàng
RENDER_MAX_CONCURRENT=
# Số giây tối đa một người chờ tới lượt dựng PDF (mặc định 300)
RENDER_QUEUE_TIMEOUT=
