{
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "full_name", "target_title", "birth_year", "gender", "facts", "expected_salary", "stats", "sections", "model_notes"],
  "properties": {
    "language": {
      "type": "string",
      "enum": ["vi", "en", "bilingual_vi_en"],
      "description": "Ngôn ngữ CV gốc."
    },
    "full_name": { "type": "string", "description": "Họ và tên ứng viên, viết hoa đầu chữ (không viết hoa toàn bộ)." },
    "target_title": { "type": ["string", "null"], "description": "Chức danh mục tiêu hoặc hiện tại." },
    "birth_year": { "type": ["integer", "null"], "description": "CHỈ năm sinh." },
    "gender": { "type": ["string", "null"] },
    "facts": {
      "type": "array",
      "description": "Dòng thông tin nhanh dưới tên, ngoài năm sinh và giới tính. Vd {label:'Mong muốn', value:'Kế toán trưởng · Full-time · TP. Hồ Chí Minh'}. KHÔNG chứa lương, liên hệ, địa chỉ nhà.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "expected_salary": { "type": ["string", "null"], "description": "Mức lương mong muốn nguyên văn như CV. Không đưa vào nơi nào khác." },
    "stats": {
      "type": "array",
      "description": "Hàng ô số liệu nổi bật, tối đa 4 ô.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label", "source"],
        "properties": {
          "value": { "type": "string", "description": "Số hoặc cụm ngắn, vd '18 năm'." },
          "label": { "type": "string", "description": "Chú thích ngắn, tối đa 35 ký tự." },
          "source": { "type": "string", "enum": ["original", "generated"] }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Các mục của CV gốc, đúng thứ tự gốc. Chỉ điền trường nội dung ứng với 'type'; các trường nội dung khác để mảng rỗng.",
      "items": { "$ref": "#/$defs/section" }
    },
    "model_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removed", "self_created", "recruiting_flags", "other"],
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" }, "description": "Loại thông tin đã bỏ (không ghi nội dung), vd 'Ngày sinh đầy đủ'." },
        "self_created": { "type": "array", "items": { "type": "string" }, "description": "Những chỗ tự lập/tự điều chỉnh." },
        "recruiting_flags": { "type": "array", "items": { "type": "string" }, "description": "Lưu ý tuyển dụng, mỗi mục một câu có mốc thời gian." },
        "other": { "type": "array", "items": { "type": "string" }, "description": "Ghi chú khác: CV song ngữ, chỗ đọc không chắc chắn..." }
      }
    }
  },
  "$defs": {
    "meta_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "description": "Dòng phụ của công việc, vd label 'Công việc chính' hoặc 'Lĩnh vực'.",
      "properties": {
        "label": { "type": ["string", "null"] },
        "text": { "type": "string" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "bullets"],
      "description": "Nhóm việc. title=null nếu CV gốc không chia nhóm.",
      "properties": {
        "title": { "type": ["string", "null"] },
        "bullets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sub_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "period", "meta", "groups"],
      "properties": {
        "name": { "type": "string" },
        "period": { "type": ["string", "null"], "description": "Dạng MM/YYYY – MM/YYYY hoặc MM/YYYY – Nay." },
        "meta": { "type": "array", "items": { "$ref": "#/$defs/meta_line" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "period", "role", "meta", "groups", "sub_roles"],
      "properties": {
        "company": { "type": "string" },
        "period": { "type": ["string", "null"], "description": "Dạng MM/YYYY – MM/YYYY hoặc MM/YYYY – Nay." },
        "role": { "type": ["string", "null"] },
        "meta": { "type": "array", "items": { "$ref": "#/$defs/meta_line" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "sub_roles": { "type": "array", "items": { "$ref": "#/$defs/sub_role" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "paragraphs", "bullets", "cards", "tags", "career_path", "jobs", "education", "references"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "bullets", "cards", "tags", "career_path", "experience", "education", "references"]
        },
        "title": { "type": "string", "description": "Tiêu đề mục theo CV gốc." },
        "paragraphs": { "type": "array", "items": { "type": "string" }, "description": "Dùng cho type=text." },
        "bullets": { "type": "array", "items": { "type": "string" }, "description": "Dùng cho type=bullets." },
        "cards": {
          "type": "array",
          "description": "Dùng cho type=cards (năng lực cốt lõi).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "items"],
            "properties": {
              "title": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Dùng cho type=tags (công cụ/phần mềm)." },
        "career_path": {
          "type": "array",
          "description": "Dùng cho type=career_path.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["period", "title", "company", "current"],
            "properties": {
              "period": { "type": "string" },
              "title": { "type": "string" },
              "company": { "type": "string" },
              "current": { "type": "boolean" }
            }
          }
        },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" }, "description": "Dùng cho type=experience." },
        "education": {
          "type": "array",
          "description": "Dùng cho type=education: văn bằng, chứng chỉ.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail", "period"],
            "properties": {
              "title": { "type": "string", "description": "Tên văn bằng/chứng chỉ (in đậm)." },
              "detail": { "type": ["string", "null"], "description": "Trường/nơi cấp, chuyên ngành." },
              "period": { "type": ["string", "null"], "description": "Năm hoặc khoảng thời gian." }
            }
          }
        },
        "references": {
          "type": "array",
          "description": "Dùng cho type=references. KHÔNG có SĐT/email.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title", "company"],
            "properties": {
              "name": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "company": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
